# Layers hold config only. Tool state never lands here because `dot` stows with
# --no-folding: directories in $HOME stay real, and only tracked leaf files
# become symlinks. That is what replaced the ~100 lines of cache/session/sqlite
# exclusions this file used to need.
backups/
tmp/

# Generated skill views — see bin/link-skills. Committed symlinks encode one
# machine's layout and fight every other machine's skill manager.
# layers/**/ (not layers/*/) so this also covers profile and host layers, not
# just common.
layers/**/home/.claude/skills
layers/**/home/.claude/agents
layers/**/home/.claude/commands
layers/**/home/.config/goose/skills
layers/**/home/.config/opencode/skills
layers/**/home/.config/opencode/agents
layers/**/home/.config/opencode/commands

# Key material. Public keys are pulled from 1Password by `dot keys` (see
# op-items.conf), not tracked here. allowed_signers is tracked on purpose.
layers/**/home/.ssh/*
!layers/**/home/.ssh/config
!layers/**/home/.ssh/config.d/
!layers/**/home/.ssh/allowed_signers

# Superseded by secrets.d/*.env pointer files, which hold no values. Kept as a
# backstop in case anything still writes the old plaintext file.
layers/**/home/.config/env.secrets

.DS_Store
*.zwc
*.bak
