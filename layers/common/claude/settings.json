{
  "env": {
    "CLAUDE_CODE_ENABLE_AUTO_MODE": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(curl:*)",
      "Bash(docker:*)",
      "Bash(gh pr create:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(just:*)",
      "Bash(ls:*)",
      "Bash(make test:*)",
      "Bash(make:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(pkill:*)",
      "Bash(pnpm:*)",
      "Bash(source ~/.zshrc)",
      "Bash(~/.claude/skills/pr-review-workflow/scripts/fetch_pr_comments.sh:*)",
      "Bash(~/.claude/skills/pr-review-workflow/scripts/reply_to_thread.sh:*)",
      "Bash(~/.claude/skills/pr-review-workflow/scripts/resolve_thread.sh:*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "LS(*)",
      "MultiEdit(*)",
      "WebFetch(domain:*)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:cafe.github.com)",
      "WebFetch(domain:github.com)",
      "mcp__pencil"
    ],
    "ask": ["Bash(rm *)", "Bash(ln *)", "Bash(mv *)", "Bash(cp *)"],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "greptile@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowUnixSockets": [
        "~/.gnupg/S.gpg-agent",
        "~/.gnupg/S.gpg-agent.extra",
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock",
        "~/.orbstack/run/docker.sock"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.claude/skills",
        "~/.docker/buildx",
        "~/.gnupg",
        "**/.git/config",
        "/var/folders/**/T/**"
      ],
      "allowRead": []
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "gh",
      "git",
      "pnpm",
      "npm",
      "docker",
      "docker compose",
      "docker-compose"
    ]
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "outputStyle": "simplified-english",
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "agentPushNotifEnabled": true
}
