# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.

font-family = IBM Plex Mono
font-size = 13

theme = Dracula

macos-option-as-alt = true

# Profile layer sets a distinct macos-icon so work/personal windows are
# visually distinguishable. Missing on machines with no profile stowed.
config-file = ?profile.ghostty
