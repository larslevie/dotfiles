# OrbStack requires its Include ahead of any Host block.
Include ~/.orbstack/ssh/config

# Per-profile host blocks. ssh takes the FIRST value it sees for a keyword, so
# these must precede the Host * defaults below.
Include ~/.ssh/config.d/*.conf

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
