# Work machines. Identity is scoped by directory, not set globally, so a personal
# repo cloned onto a work laptop still gets the personal address.
#
# Personal is the DEFAULT and work is opt-in by location: leaking a personal
# address into a work repo is awkward, leaking a work address into a public
# repo is worse.
[include]
	path = ~/.config/git/identity-personal.gitconfig

[includeIf "gitdir:~/werk/"]
	path = ~/.config/git/identity-work.gitconfig
[includeIf "gitdir:~/personal/"]
	path = ~/.config/git/identity-personal.gitconfig

[url "ssh://git@github-cincpro/cincpro/"]
	insteadOf = ssh://git@github.com/cincpro/
[url "git@github-cincpro:cincpro/"]
	insteadOf = git@github.com:cincpro/
[url "ssh://git@github-realgeeks/RealGeeks/"]
	insteadOf = ssh://git@github.com/realgeeks/
[url "git@github-realgeeks:RealGeeks/"]
	insteadOf = git@github.com:RealGeeks/

[credential "https://dev.azure.com"]
	useHttpPath = true
