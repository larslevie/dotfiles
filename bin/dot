#!/usr/bin/env bash
# Apply dotfiles for this machine: common layer, then its profile, then its host overlay.
set -euo pipefail

# -P (not plain pwd) so this agrees with abs_dest()'s physical resolution —
# /tmp and /var are themselves symlinks on macOS, and a logical/physical
# mismatch here would make every wronglink check a false positive.
DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$DOTFILES"

die() { printf '%s\n' "dot: $*" >&2; exit 1; }
info() { printf '\033[1m==>\033[0m %s\n' "$*"; }

host_name() { scutil --get LocalHostName 2>/dev/null || hostname -s; }

profile_for() {
  local host=$1 h p
  while read -r h p; do
    [[ -z ${h:-} || $h == \#* ]] && continue
    [[ $h == "$host" ]] && { printf '%s\n' "$p"; return 0; }
  done < machines.conf
  return 1
}

# Layer dirs to stow, in application order. Only those with a home/ to stow.
layer_dirs() {
  local host=$1 profile=$2 d
  for d in layers/common "layers/profiles/$profile" "layers/hosts/$host"; do
    [[ -d $d/home ]] && printf '%s\n' "$d"
  done
}

# Same order, but includes a layer that has only op-items.conf or
# unmanaged.conf and no home/ to stow — e.g. a claude-only host layer.
all_layer_dirs() {
  local d
  for d in layers/common "layers/profiles/$PROFILE" "layers/hosts/$HOST"; do
    [[ -d $d ]] && printf '%s\n' "$d"
  done
  return 0
}

# Absolute, normalized destination of a symlink. Fails on a dangling link,
# i.e. one whose destination's parent is gone.
abs_dest() {
  local l=$1 t d
  t=$(readlink "$l") || return 1
  [[ $t == /* ]] || t="$(dirname "$l")/$t"
  d=$(cd "$(dirname "$t")" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s\n' "$d" "$(basename "$t")"
}

# --no-folding keeps directories real so tools writing state (~/.claude/, ~/.config/gcloud/)
# never land inside the repo. Only tracked leaf files become symlinks.
stow_layers() {
  local mode=$1 host=$2 profile=$3 d
  while read -r d; do
    info "stow $mode $d"
    stow --no-folding --dir="$d" --target="$HOME" $mode home
  done < <(layer_dirs "$host" "$profile")
}

resolve() {
  HOST=$(host_name)
  PROFILE=$(profile_for "$HOST") || die "host '$HOST' not in machines.conf — add '$HOST <work|personal>'"
  [[ -d layers/profiles/$PROFILE ]] || die "no such profile: layers/profiles/$PROFILE"
}

# Stow refuses to overwrite a real file. Move pre-existing targets aside once so a
# fresh machine (or one predating this layout) can be adopted without hand-cleanup.
backup_conflicts() {
  local stamp=$1 d rel target moved=0
  while read -r d; do
    while IFS= read -r rel; do
      target="$HOME/$rel"
      [[ -e $target && ! -L $target ]] || continue
      mkdir -p "$(dirname "$DOTFILES/backups/$stamp/$rel")"
      mv "$target" "$DOTFILES/backups/$stamp/$rel"
      printf '    %s\n' "$rel"
      moved=1
    done < <(cd "$d/home" && find . -type f | sed 's|^\./||')
  done < <(layer_dirs "$HOST" "$PROFILE")
  [[ $moved == 1 ]] && info "backed up to backups/$stamp"
  return 0
}

ensure_clt() {
  xcode-select -p >/dev/null 2>&1 && return 0
  info "installing Xcode Command Line Tools"
  # Opens a GUI installer; poll until it finishes rather than racing it.
  xcode-select --install 2>/dev/null || true
  until xcode-select -p >/dev/null 2>&1; do
    printf '    waiting for the Command Line Tools installer to finish...\n'
    sleep 20
  done
}

ensure_brew() {
  command -v brew >/dev/null && return 0
  info "installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  local b
  for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [[ -x $b ]] && { eval "$("$b" shellenv)"; break; }
  done
  command -v brew >/dev/null || die "Homebrew installed but not on PATH"
}

ensure_stow() {
  command -v stow >/dev/null && return 0
  info "installing stow"
  brew install stow
}

# A new machine isn't in machines.conf yet. Take the profile from argv, or ask.
register_host() {
  local host=$1 want=${2:-}
  profile_for "$host" >/dev/null 2>&1 && return 0
  if [[ -z $want ]]; then
    [[ -t 0 ]] || die "host '$host' is unregistered; re-run as: dot bootstrap <profile>"
    local avail
    avail=$(find layers/profiles -maxdepth 1 -mindepth 1 -type d -exec basename {} \; | sort | tr '\n' ' ')
    printf 'Machine "%s" is not registered.\nProfiles: %s\nProfile: ' "$host" "$avail"
    read -r want
  fi
  [[ -d layers/profiles/$want ]] || die "no such profile: $want"
  printf '%s\t%s\n' "$host" "$want" >> machines.conf
  info "registered $host as $want in machines.conf"
}

do_link() { # do_link [backup] [-- <merge-claude-settings args>]
  command -v stow >/dev/null || die "stow not installed: brew install stow"
  if [[ ${1:-} == backup ]]; then
    shift
    info "backing up existing real files that stow would collide with"
    backup_conflicts "$(date +%Y%m%d-%H%M%S)"
  fi
  stow_layers "--restow" "$HOST" "$PROFILE"
  info "linking skill views"
  "$DOTFILES/bin/link-skills"
  info "merging Claude settings"
  do_claude "$@"
}

# Claude Code reads exactly one user settings file and has no include
# mechanism, so the layers are merged into it here instead.
do_claude() {
  "$DOTFILES/bin/merge-claude-settings" \
    --root "$DOTFILES" --profile "$PROFILE" --host "$HOST" "$@"
}

do_brew() {
  local f
  for f in layers/common/home/.config/homebrew/Brewfile \
           "layers/profiles/$PROFILE/home/.config/homebrew/Brewfile.$PROFILE"; do
    [[ -f $f ]] || continue
    info "brew bundle $f"
    brew bundle --file="$f"
  done
}

# SSH public keys live in 1Password, not in this repo (only the private
# material is secret, but keeping the pair together avoids a second source of
# truth). Each layer may list its own in op-items.conf, outside home/ so stow
# never touches it. Safe to re-run; each pull just overwrites the target.
do_keys() {
  command -v op >/dev/null || { info "1Password CLI not installed, skipping key pull (brew install --cask 1password-cli)"; return 0; }
  local d manifest rel ref target failed=0
  while read -r d; do
    manifest="$d/op-items.conf"
    [[ -f $manifest ]] || continue
    info "pulling keys from $manifest"
    while read -r rel ref; do
      [[ -z $rel || $rel == \#* ]] && continue
      target="$HOME/$rel"
      mkdir -p "$(dirname "$target")"
      if op read "$ref" > "$target" 2>/dev/null; then
        chmod 644 "$target"
        printf '    %s\n' "$rel"
      else
        rm -f "$target"
        printf '    %s FAILED\n' "$rel"
        failed=1
      fi
    done < "$manifest"
  done < <(all_layer_dirs)
  [[ $failed == 0 ]] || { info "some keys weren't pulled — approve the 1Password prompt and rerun 'dot keys'"; return 1; }
}

case ${1:-apply} in
  bootstrap)
    ensure_clt
    ensure_brew
    ensure_stow
    register_host "$(host_name)" "${2:-}"
    resolve
    do_link backup
    do_brew
    do_keys || true
    "$0" doctor || true
    cat <<'NEXT'

==> Done. Remaining steps need you:
    1. Sign in to 1Password and enable Settings > Developer > SSH agent
       and "Integrate with 1Password CLI"
       (git signing, every github-* host alias, and 'dot keys' depend on it;
       if you signed in just now, run 'dot keys' to pull SSH public keys)
    2. gh auth login
    3. aws sso login --profile witco-login   (work machines)
    4. Open a new shell
NEXT
    ;;
  info)
    resolve
    printf 'host     %s\nprofile  %s\nlayers   %s\n' \
      "$HOST" "$PROFILE" "$(layer_dirs "$HOST" "$PROFILE" | tr '\n' ' ')"
    ;;
  check)
    resolve
    command -v stow >/dev/null || die "stow not installed: brew install stow"
    stow_layers "--simulate --verbose=1" "$HOST" "$PROFILE"
    ;;
  adopt)
    resolve
    do_link backup
    ;;
  apply)
    resolve
    shift || true
    do_link "$@"
    ;;
  claude)
    resolve
    case ${2:-apply} in
      apply)  do_claude ;;
      force)  do_claude --force ;;
      adopt)  do_claude --adopt ;;
      check)  do_claude --check ;;
      *) die "usage: dot claude {apply|force|adopt|check}" ;;
    esac
    ;;
  unlink)
    resolve
    stow_layers "--delete" "$HOST" "$PROFILE"
    ;;
  doctor)
    resolve
    # A tool that saves by atomic rename (write temp, mv over) replaces the
    # symlink with a real file. The repo then silently stops tracking it.
    bad=0
    while read -r d; do
      while IFS= read -r rel; do
        target="$HOME/$rel"
        if [[ -e $target && ! -L $target ]]; then
          printf 'detached  %s\n' "$rel"; bad=$((bad+1))
        elif [[ ! -e $target ]]; then
          printf 'missing   %s\n' "$rel"; bad=$((bad+1))
        else
          dest=$(abs_dest "$target") || dest=
          [[ $dest == "$DOTFILES/$d/home/$rel" ]] || {
            printf 'wronglink %s -> %s\n' "$rel" "${dest:-$(readlink "$target")}"
            bad=$((bad+1))
          }
        fi
      done < <(cd "$d/home" && find . -type f | sed 's|^\./||')
    done < <(layer_dirs "$HOST" "$PROFILE")
    for l in "$HOME"/.claude/skills "$HOME"/.config/agents/skills/*; do
      [[ -L $l && ! -e $l ]] && { printf 'dangling  %s\n' "${l#"$HOME"/}"; bad=$((bad+1)); }
    done
    while read -r d; do
      [[ -f "$d/op-items.conf" ]] || continue
      while read -r rel _; do
        [[ -z $rel || $rel == \#* ]] && continue
        [[ -e "$HOME/$rel" ]] || { printf 'unpulled  %s (dot keys)\n' "$rel"; bad=$((bad+1)); }
      done < "$d/op-items.conf"
    done < <(all_layer_dirs)
    do_claude --check || bad=$((bad+1))
    if [[ $bad == 0 ]]; then
      info "all links healthy"
    else
      printf '\n%s\n' "$bad problem(s). 'dot adopt' backs up detached files and relinks."
      exit 1
    fi
    ;;
  brew)
    resolve
    do_brew
    ;;
  keys)
    resolve
    do_keys
    ;;
  *)
    die "usage: dot {bootstrap|info|check|apply|adopt|doctor|unlink|brew|keys|claude}"
    ;;
esac
