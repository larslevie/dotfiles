#!/usr/bin/env python3
"""Merge layered Claude Code settings into ~/.claude/settings.json.

Claude Code reads exactly one user settings file and offers no include
mechanism, so layering has to happen before it starts. Sources, merged in
order, each optional:

    layers/common/claude/settings.json
    layers/profiles/<profile>/claude/settings.json
    layers/hosts/<host>/claude/settings.json

Merge rules: objects merge deeply, lists concatenate and de-duplicate
(preserving first-seen order, which is what permission allow-lists want),
scalars are replaced. To replace a list outright rather than extend it, name
the key with a trailing "!" in the overriding layer.

Because the result is generated it cannot also be a symlink into the repo, and
Claude Code rewrites settings.json itself when you change options in the app
(model, theme, notification prefs...). So the last generated result is
recorded alongside it; if the live file has drifted from that, the drift is
folded into the host layer automatically — not common, since app-driven
changes are usually per-machine UI state, not something every machine should
inherit. Promote a change to common by hand if it really is global. --force
discards local drift instead of adopting it.
"""

import argparse
import json
import sys
from pathlib import Path

HOME = Path.home()
LIVE = HOME / ".claude" / "settings.json"
STAMP = HOME / ".claude" / ".settings.generated.json"


def merge(base, over):
    if isinstance(base, dict) and isinstance(over, dict):
        out = dict(base)
        for key, value in over.items():
            if key.endswith("!"):
                out[key[:-1]] = value
            elif key in out:
                out[key] = merge(out[key], value)
            else:
                out[key] = value
        return out
    if isinstance(base, list) and isinstance(over, list):
        seen, out = set(), []
        for item in base + over:
            marker = json.dumps(item, sort_keys=True)
            if marker not in seen:
                seen.add(marker)
                out.append(item)
        return out
    return over


def load(path):
    if not path.is_file():
        return {}
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        sys.exit(f"merge-claude-settings: {path} is not valid JSON: {exc}")


def render(sources):
    result = {}
    for path in sources:
        result = merge(result, load(path))
    return json.dumps(result, indent=2) + "\n"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", required=True, help="dotfiles repo root")
    ap.add_argument("--profile", required=True)
    ap.add_argument("--host", required=True)
    ap.add_argument("--force", action="store_true", help="discard local drift")
    ap.add_argument("--adopt", action="store_true",
                    help="accepted for compatibility; adopting drift is now the default")
    ap.add_argument("--check", action="store_true", help="report drift, write nothing")
    args = ap.parse_args()

    root = Path(args.root)
    sources = [
        root / "layers/common/claude/settings.json",
        root / f"layers/profiles/{args.profile}/claude/settings.json",
        root / f"layers/hosts/{args.host}/claude/settings.json",
    ]
    target = sources[-1]
    present = [p for p in sources if p.is_file()]
    if not present:
        return

    wanted = render(sources)
    live = None if args.force else (LIVE.read_text() if LIVE.is_file() else None)

    live_obj = None
    if live is not None:
        try:
            live_obj = json.loads(live)
        except json.JSONDecodeError as exc:
            sys.exit(f"merge-claude-settings: {LIVE} is not valid JSON: {exc}\n"
                      f"  discard it:  dot claude apply --force")

    stamped = STAMP.read_text() if STAMP.is_file() else None
    stamped_obj = json.loads(stamped) if stamped is not None else None

    # A missing stamp means this file was never generated, so treat all of it
    # as local rather than silently overwriting a hand-edited file.
    drifted = live_obj is not None and live_obj != stamped_obj

    if args.check:
        if drifted:
            print("drift  ~/.claude/settings.json changed since it was generated")
            print(f"       'dot apply' folds it into {target.relative_to(root)}")
            sys.exit(1)
        print("ok     ~/.claude/settings.json matches the layers")
        return

    if drifted:
        # Claude Code rewrites model/theme/voiceEnabled itself, so this is
        # routine. Fold into the host layer, not common, so one machine's UI
        # state doesn't apply to every other machine; promote to common by
        # hand if a change is really global.
        base = {}
        for path in sources[:-1]:
            base = merge(base, load(path))
        delta = subtract(live_obj, base)
        if delta:
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(json.dumps(merge(load(target), delta), indent=2) + "\n")
            print(f"adopted local changes into {target.relative_to(root)}")
            wanted = render(sources)

    if live == wanted:
        STAMP.write_text(wanted)
        return

    LIVE.parent.mkdir(parents=True, exist_ok=True)
    # A generated file cannot also be a symlink into the repo — writing through
    # one would edit a layer instead of the result.
    if LIVE.is_symlink():
        LIVE.unlink()
    LIVE.write_text(wanted)
    STAMP.write_text(wanted)
    print(f"wrote ~/.claude/settings.json from {len(present)} layer(s)")


def subtract(value, other):
    """Drop from `value` anything `other` already provides identically.

    Note: since merge() concatenates lists, removing an entry from a
    common-supplied list can't be expressed by adopting — it reappears on the
    next render. Inherent to the merge model; edit the source layer instead.
    """
    if isinstance(value, dict) and isinstance(other, dict):
        out = {}
        for key, inner in value.items():
            if key not in other:
                out[key] = inner
            else:
                pruned = subtract(inner, other[key])
                if pruned not in (None, {}, []):
                    out[key] = pruned
        return out
    if isinstance(value, list) and isinstance(other, list):
        marks = {json.dumps(i, sort_keys=True) for i in other}
        return [i for i in value if json.dumps(i, sort_keys=True) not in marks]
    return None if value == other else value


if __name__ == "__main__":
    main()
